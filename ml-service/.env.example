# ML Service Environment Variables
# Smart Vaccination System - ML Microservice Configuration

# Server Configuration
ML_PORT=8000
ML_HOST=0.0.0.0
ENVIRONMENT=development

# Model Configuration
FACE_MODEL=VGG-Face
FACE_DETECTOR=opencv
DISTANCE_METRIC=cosine

# Thresholds
FACE_CONFIDENCE_THRESHOLD=0.7
DELTOID_CONFIDENCE_THRESHOLD=0.5

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Logging
LOG_LEVEL=INFO
